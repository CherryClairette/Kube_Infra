{
  "realm": "kube",
  "displayName": "Kube project",
  "enabled": true,
  "sslRequired": "external",
  "groups": [
    { "name": "k8s-admins" },
    { "name": "k8s-viewers" }
  ],
  "users": [
    {
      "username": "testuser",
      "email": "testuser@example.com",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "${TEST_USER_PASSWORD}", "temporary": false }
      ],
      "groups": ["/k8s-viewers"]
    }
  ],
  "clients": [
    {
      "clientId": "dex",
      "name": "dex",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${DEX_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://dex.13.135.22.141.sslip.io/callback"],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
